      when regexp_matches(regexp_replace(regexp_replace(trim(cast(estimated_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '^[0-9]{1,2}-[A-Za-z]{3}-[0-9]{2}$')
        then try_strptime(regexp_replace(regexp_replace(trim(cast(estimated_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '%d-%b-%y')

      -- 15/06/2024 or 6/15/2024 or ambiguous 1/5/2024
      when regexp_matches(regexp_replace(regexp_replace(trim(cast(estimated_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$') then
        case
          when try_cast(split_part(regexp_replace(regexp_replace(trim(cast(estimated_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '/', 1) as integer) > 12
            then try_strptime(regexp_replace(regexp_replace(trim(cast(estimated_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '%d/%m/%Y')
          when try_cast(split_part(regexp_replace(regexp_replace(trim(cast(estimated_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '/', 2) as integer) > 12
            then try_strptime(regexp_replace(regexp_replace(trim(cast(estimated_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '%m/%d/%Y')
          else try_strptime(regexp_replace(regexp_replace(trim(cast(estimated_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '%m/%d/%Y')
        end

      else null
    end
  as date)
 is null)         as invalid_estimated_delivery,
    (nullif(trim(cast(actual_delivery as varchar)), '') is not null
       and cast(
    case
      when nullif(regexp_replace(regexp_replace(trim(cast(actual_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '') is null then null

      -- 2024-06-09
      when regexp_matches(regexp_replace(regexp_replace(trim(cast(actual_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '^[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}$')
        then try_strptime(regexp_replace(regexp_replace(trim(cast(actual_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '%Y-%m-%d')

      -- 09-Jun-2024
      when regexp_matches(regexp_replace(regexp_replace(trim(cast(actual_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '^[0-9]{1,2}-[A-Za-z]{3}-[0-9]{4}$')
        then try_strptime(regexp_replace(regexp_replace(trim(cast(actual_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '%d-%b-%Y')

      -- 09-Jun-24
      when regexp_matches(regexp_replace(regexp_replace(trim(cast(actual_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '^[0-9]{1,2}-[A-Za-z]{3}-[0-9]{2}$')
        then try_strptime(regexp_replace(regexp_replace(trim(cast(actual_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '%d-%b-%y')

      -- 15/06/2024 or 6/15/2024 or ambiguous 1/5/2024
      when regexp_matches(regexp_replace(regexp_replace(trim(cast(actual_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$') then
        case
          when try_cast(split_part(regexp_replace(regexp_replace(trim(cast(actual_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '/', 1) as integer) > 12
            then try_strptime(regexp_replace(regexp_replace(trim(cast(actual_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '%d/%m/%Y')
          when try_cast(split_part(regexp_replace(regexp_replace(trim(cast(actual_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '/', 2) as integer) > 12
            then try_strptime(regexp_replace(regexp_replace(trim(cast(actual_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '%m/%d/%Y')
          else try_strptime(regexp_replace(regexp_replace(trim(cast(actual_delivery as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '%m/%d/%Y')
        end

      else null
    end
  as date)
 is null)            as invalid_actual_delivery
from source_sales
  );

