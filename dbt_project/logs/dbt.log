  create view "ecommerce_warehouse"."staging"."stg_customers__dbt_tmp" as (
    

select
    nullif(trim(cast(customer_id as varchar)), '')  as customer_id,

    -- PII: hashed, never exposed downstream
    case when nullif(trim(cast(email as varchar)), '') is not null
         then md5(lower(trim(email))) end            as email_hash,
    case when nullif(trim(cast(phone_number as varchar)), '') is not null
         then md5(trim(phone_number)) end            as phone_hash,
    (nullif(trim(cast(email as varchar)), '') is not null)          as has_email,

    cast(
    case
      when nullif(regexp_replace(regexp_replace(trim(cast(signup_date as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '') is null then null

      -- 2024-06-09
      when regexp_matches(regexp_replace(regexp_replace(trim(cast(signup_date as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '^[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}$')
        then try_strptime(regexp_replace(regexp_replace(trim(cast(signup_date as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '%Y-%m-%d')

      -- 09-Jun-2024
      when regexp_matches(regexp_replace(regexp_replace(trim(cast(signup_date as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '^[0-9]{1,2}-[A-Za-z]{3}-[0-9]{4}$')
        then try_strptime(regexp_replace(regexp_replace(trim(cast(signup_date as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '%d-%b-%Y')

      -- 09-Jun-24
      when regexp_matches(regexp_replace(regexp_replace(trim(cast(signup_date as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '^[0-9]{1,2}-[A-Za-z]{3}-[0-9]{2}$')
        then try_strptime(regexp_replace(regexp_replace(trim(cast(signup_date as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '%d-%b-%y')

      -- 15/06/2024 or 6/15/2024 or ambiguous 1/5/2024
      when regexp_matches(regexp_replace(regexp_replace(trim(cast(signup_date as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$') then
        case
          when try_cast(split_part(regexp_replace(regexp_replace(trim(cast(signup_date as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '/', 1) as integer) > 12
            then try_strptime(regexp_replace(regexp_replace(trim(cast(signup_date as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '%d/%m/%Y')
          when try_cast(split_part(regexp_replace(regexp_replace(trim(cast(signup_date as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '/', 2) as integer) > 12
            then try_strptime(regexp_replace(regexp_replace(trim(cast(signup_date as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '%m/%d/%Y')
          else try_strptime(regexp_replace(regexp_replace(trim(cast(signup_date as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '%m/%d/%Y')
        end

      else null
    end
  as date)
            as signup_date,

    case
      when lower(trim(gender)) in ('female','femal','femle','f') then 'Female'
      when lower(trim(gender)) in ('male','m','mal')             then 'Male'
      when lower(trim(gender)) in ('other','o')                  then 'Other'
      else 'Unknown'
    end as gender,

    list_aggr(
    list_transform(
        string_split(lower(trim(cast(nullif(trim(cast(city as varchar)), '') as varchar))), ' '),
        w -> upper(left(w, 1)) || substr(w, 2)
    ),
    'string_agg', ' '
)    as city,
    list_aggr(
    list_transform(
        string_split(lower(trim(cast(nullif(trim(cast(region as varchar)), '') as varchar))), ' '),
        w -> upper(left(w, 1)) || substr(w, 2)
    ),
    'string_agg', ' '
)  as customer_region,

    case
      when lower(trim(loyalty_tier)) in ('silver','silvr')     then 'Silver'
      when lower(trim(loyalty_tier)) in ('gold','gld')         then 'Gold'
      when lower(trim(loyalty_tier)) in ('platinum','platnum') then 'Platinum'
      when lower(trim(loyalty_tier)) in ('bronze','brnze')     then 'Bronze'
      when nullif(trim(cast(loyalty_tier as varchar)), '') is null            then 'Unknown'
      else list_aggr(
    list_transform(
        string_split(lower(trim(cast(loyalty_tier as varchar))), ' '),
        w -> upper(left(w, 1)) || substr(w, 2)
    ),
    'string_agg', ' '
)
    end as loyalty_tier,

    case
      when lower(replace(trim(preferred_payment), ' ', '')) = 'creditcard'   then 'Credit Card'
      when lower(replace(trim(preferred_payment), ' ', '')) = 'debitcard'    then 'Debit Card'
      when lower(replace(trim(preferred_payment), ' ', '')) = 'banktransfer' then 'Bank Transfer'
      when lower(replace(trim(preferred_payment), ' ', '')) = 'paypal'       then 'PayPal'
      when lower(replace(trim(preferred_payment), ' ', '')) = 'cash'         then 'Cash'
      when nullif(trim(cast(preferred_payment as varchar)), '') is null                     then 'Unknown'
      else list_aggr(
    list_transform(
        string_split(lower(trim(cast(preferred_payment as varchar))), ' '),
        w -> upper(left(w, 1)) || substr(w, 2)
    ),
    'string_agg', ' '
)
    end as preferred_payment,

    try_cast(age as integer)                                         as customer_age,
    coalesce(list_aggr(
    list_transform(
        string_split(lower(trim(cast(nullif(trim(cast(customer_segment as varchar)), '') as varchar))), ' '),
        w -> upper(left(w, 1)) || substr(w, 2)
    ),
    'string_agg', ' '
), 'Unknown')     as customer_segment,
    coalesce(list_aggr(
    list_transform(
        string_split(lower(trim(cast(nullif(trim(cast(acquisition_channel as varchar)), '') as varchar))), ' '),
        w -> upper(left(w, 1)) || substr(w, 2)
    ),
    'string_agg', ' '
), 'Unknown')  as acquisition_channel,
    nullif(trim(cast(acquisition_campaign_id as varchar)), '')                      as acquisition_campaign_id,

    (nullif(trim(cast(signup_date as varchar)), '') is not null
       and cast(
    case
      when nullif(regexp_replace(regexp_replace(trim(cast(signup_date as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '') is null then null

      -- 2024-06-09
      when regexp_matches(regexp_replace(regexp_replace(trim(cast(signup_date as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '^[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}$')
