      -- 09-Jun-2024
      when regexp_matches(regexp_replace(regexp_replace(trim(cast(signup_date as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '^[0-9]{1,2}-[A-Za-z]{3}-[0-9]{4}$')
        then try_strptime(regexp_replace(regexp_replace(trim(cast(signup_date as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '%d-%b-%Y')

      -- 09-Jun-24
      when regexp_matches(regexp_replace(regexp_replace(trim(cast(signup_date as varchar)), '(?i)-Sept-', '-Sep-'), '[ T][0-9]{1,2}:[0-9]{2}.*$', ''), '^[0-9]{1,2}-[A-Za-z]{3}-[0-9]{2}$')
