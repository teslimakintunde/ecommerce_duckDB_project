      when lower(replace(trim(payment_method), ' ', '')) = 'cash'         then 'Cash'
      when nullif(trim(cast(payment_method as varchar)), '') is null                     then 'Unknown'
      else list_aggr(
    list_transform(
        string_split(lower(trim(cast(payment_method as varchar))), ' '),
